  "item": [
    {
      "name": "06 - Authentication",
      "item": [
        {
          "name": "POST - Generate Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Token generado correctamente\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response.token).to.be.a(\"string\");\r",
                  "    pm.expect(response.token).to.not.be.empty;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Autenticación exitosa\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "\r",
                  "pm.test(\"La respuesta contiene un token\", function () {\r",
                  "    pm.expect(response.token).to.exist;\r",
                  "});\r",
                  "\r",
                  "// Guardar token en Environment\r",
                  "pm.environment.set(\"authToken\", response.token);\r",
                  "\r",
                  "console.log(\"Token guardado correctamente\");\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"{{username}}\",\r\n    \"password\": \"{{password}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/auth",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - POST Requests",
      "item": [
        {
          "name": "Post - Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "pm.test(\"La reserva fue creada correctamente\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const response = pm.response.json();\r",
                  "pm.environment.set(\"bookingId\", response.bookingid);\r",
                  "console.log(\"Booking ID:\", response.bookingid);\r",
                  "console.log(\"Booking ID guardado:\", pm.environment.get(\"bookingId\"));\r",
                  "\r",
                  "pm.test(\"La respuesta contiene bookingid\", function () {\r",
                  "    pm.expect(response.bookingid).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene firstname\", function () {\r",
                  "    pm.expect(response.booking.firstname).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene lastname\", function () {\r",
                  "    pm.expect(response.booking.lastname).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"La respuesta contiene bookingdates\", function () {\r",
                  "    pm.expect(response.booking.bookingdates).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Debe retornar el nombre correcto\", function () {\r",
                  "    pm.expect(response.booking.firstname)\r",
                  "        .to.eql(\"Nadia\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Debe retornar el apellido correcto\", function () {\r",
                  "    pm.expect(response.booking.lastname)\r",
                  "        .to.eql(\"Castillo\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"El precio debe ser correcto\", function () {\r",
                  "    pm.expect(response.booking.totalprice)\r",
                  "        .to.eql(150000);\r",
                  "});\r",
                  "\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"firstname\": \"Nadia\",\r\n    \"lastname\": \"Castillo\",\r\n    \"totalprice\": 150000,\r\n    \"depositpaid\": true,\r\n    \"bookingdates\": {\r\n        \"checkin\": \"2026-12-01\",\r\n        \"checkout\": \"2026-12-05\"\r\n    },\r\n    \"additionalneeds\": \"Breakfast\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
