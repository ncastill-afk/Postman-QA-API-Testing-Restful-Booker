    {
      "name": "01 - GET Requests",
      "item": [
        {
          "name": "Get Todo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "\r",
                  "// Validar Status Code\r",
                  "pm.test(\"Status code debe ser 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Validar formato JSON\r",
                  "pm.test(\"La respuesta debe ser JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "// Validar que la respuesta sea un array\r",
                  "pm.test(\"La respuesta debe ser un array\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    pm.expect(response).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "// Validar estructura de los registros\r",
                  "pm.test(\"Los registros deben contener bookingid\", function () {\r",
                  "    const response = pm.response.json();\r",
                  "\r",
                  "    response.forEach(booking => {\r",
                  "        pm.expect(booking).to.have.property(\"bookingid\");\r",
                  "        pm.expect(booking.bookingid).to.be.a(\"number\");\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "// Validar tiempo de respuesta\r",
                  "pm.test(\"Tiempo de respuesta menor a 2000 ms\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
